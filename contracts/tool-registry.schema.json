{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rebim.local/contracts/0.1.0/tool-registry.schema.json",
  "title": "ReBIM Tool Registry",
  "type": "object",
  "required": ["protocolVersion", "version", "tools"],
  "properties": {
    "protocolVersion": { "const": "0.1.0" },
    "version": { "const": "0.1.0" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "risk",
          "modes",
          "description",
          "mutatesModel",
          "requiresApproval",
          "parameters"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "risk": {
            "type": "string",
            "enum": ["READ", "UI", "SAFE_WRITE", "WRITE", "DESTRUCTIVE"]
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["Ask", "Analyze", "Edit", "Automate"]
            }
          },
          "description": { "type": "string", "minLength": 1 },
          "mutatesModel": { "type": "boolean" },
          "requiresApproval": { "type": "boolean" },
          "parameters": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
