<UserControl x:Class="ReBIM.Revit.Addin.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Mode and Provider -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10">
            <StackPanel>
                <TextBlock Text="ReBIM Copilot" 
                          Foreground="White" 
                          FontSize="16" 
                          FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <ComboBox x:Name="ModeComboBox" 
                             Width="100" 
                             SelectedIndex="0"
                             SelectionChanged="ModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Ask"/>
                        <ComboBoxItem Content="Analyze"/>
                        <ComboBoxItem Content="Edit"/>
                        <ComboBoxItem Content="Automate"/>
                    </ComboBox>
                    <ComboBox x:Name="ProviderComboBox" 
                             Width="100" 
                             Margin="10,0,0,0"
                             SelectedIndex="0">
                        <ComboBoxItem Content="Ollama"/>
                        <ComboBoxItem Content="OpenAI"/>
                        <ComboBoxItem Content="Claude"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Context Chips -->
        <Border Grid.Row="1" Background="#3E3E42" Padding="10">
            <StackPanel>
                <TextBlock Text="Current Context" 
                          Foreground="#CCCCCC" 
                          FontSize="11" 
                          Margin="0,0,0,5"/>
                <WrapPanel x:Name="ContextChipsPanel">
                    <Border Background="#007ACC" 
                           CornerRadius="3" 
                           Padding="5,2" 
                           Margin="0,0,5,5">
                        <TextBlock x:Name="ViewChip" 
                                  Text="View: -" 
                                  Foreground="White" 
                                  FontSize="11"/>
                    </Border>
                    <Border Background="#1E1E1E" 
                           CornerRadius="3" 
                           Padding="5,2" 
                           Margin="0,0,5,5">
                        <TextBlock x:Name="SelectionChip" 
                                  Text="Selection: 0" 
                                  Foreground="White" 
                                  FontSize="11"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Chat History -->
        <ScrollViewer Grid.Row="2" 
                     VerticalScrollBarVisibility="Auto"
                     Background="#1E1E1E">
            <StackPanel x:Name="ChatHistoryPanel" 
                       Margin="10"/>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="3" 
               Background="#252526" 
               Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PromptTextBox" 
                        Grid.Column="0"
                        Height="60"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        Background="#3C3C3C"
                        Foreground="White"
                        BorderBrush="#007ACC"
                        Padding="5"
                        KeyDown="PromptTextBox_KeyDown"/>
                <Button x:Name="SendButton" 
                       Grid.Column="1"
                       Content="Send" 
                       Width="60"
                       Height="60"
                       Margin="10,0,0,0"
                       Background="#007ACC"
                       Foreground="White"
                       Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
