{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rebim.local/contracts/0.1.0/error-codes.schema.json",
  "title": "ReBIM Error Catalog",
  "type": "object",
  "required": ["protocolVersion", "version", "errors"],
  "properties": {
    "protocolVersion": { "const": "0.1.0" },
    "version": { "const": "0.1.0" },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "message", "action"],
        "properties": {
          "code": { "type": "string", "pattern": "^REBIM_[A-Z0-9_]+$" },
          "message": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
