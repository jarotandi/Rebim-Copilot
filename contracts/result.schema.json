{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rebim.local/contracts/0.1.0/result.schema.json",
  "title": "ReBIM Result Envelope",
  "description": "Canonical command result envelope.",
  "type": "object",
  "required": ["protocolVersion", "requestId", "ok"],
  "properties": {
    "protocolVersion": { "const": "0.1.0" },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ok": { "type": "boolean" },
    "result": {},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "REBIM_VALIDATION_ERROR",
            "REBIM_CAPABILITY_UNAVAILABLE",
            "REBIM_PERMISSION_DENIED",
            "REBIM_STALE_CONTEXT",
            "REBIM_IPC_UNAVAILABLE",
            "REBIM_REVIT_CONTEXT_BUSY",
            "REBIM_EXECUTION_FAILED",
            "REBIM_PROVIDER_UNAVAILABLE",
            "REBIM_CLOUD_BLOCKED"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "hint": { "type": "string" },
        "details": {}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ok": { "const": true } },
        "required": ["ok"]
      },
      "then": {
        "required": ["result"],
        "not": { "required": ["error"] }
      }
    },
    {
      "if": {
        "properties": { "ok": { "const": false } },
        "required": ["ok"]
      },
      "then": {
        "required": ["error"],
        "not": { "required": ["result"] }
      }
    }
  ],
  "additionalProperties": false
}
