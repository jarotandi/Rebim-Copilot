    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <AssemblyName>ReBIM.Revit.Addin</AssemblyName>
    <RootNamespace>ReBIM.Revit.Addin</RootNamespace>
    <Version>0.1.0</Version>
    <Description>ReBIM Copilot Hybrid - Revit 2025 Add-in</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
