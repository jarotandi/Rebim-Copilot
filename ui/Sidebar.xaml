<UserControl x:Class="ReBIM.Revit.Addin.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="350"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15">
            <TextBlock Text="ReBIM Copilot" 
                      Foreground="White" 
                      FontSize="18" 
                      FontWeight="SemiBold"/>
        </Border>

        <!-- Status -->
        <Border Grid.Row="1" Background="#252526" Padding="10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Status" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,3"/>
                <TextBlock x:Name="StatusText" Text="Revit Connected" Foreground="#4EC9B0" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Mode -->
        <Border Grid.Row="2" Background="#252526" Padding="10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Mode" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,3"/>
                <ComboBox x:Name="ModeComboBox" 
                         SelectedIndex="0"
                         Background="#3C3C3C"
                         Foreground="White"
                         BorderBrush="#007ACC"
                         Padding="5">
                    <ComboBoxItem Content="Ask"/>
                    <ComboBoxItem Content="Analyze"/>
                    <ComboBoxItem Content="Edit"/>
                    <ComboBoxItem Content="Automate"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Provider -->
        <Border Grid.Row="3" Background="#252526" Padding="10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Provider" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,3"/>
                <TextBlock x:Name="ProviderText" Text="Not configured" Foreground="#9CDCFE" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Current View -->
        <Border Grid.Row="4" Background="#252526" Padding="10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Current View" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,3"/>
                <TextBlock x:Name="ViewText" Text="..." Foreground="White" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Selection -->
        <Border Grid.Row="5" Background="#252526" Padding="10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Selection" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,3"/>
                <TextBlock x:Name="SelectionText" Text="..." Foreground="White" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="6" Background="#252526" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PromptTextBox" 
                        Grid.Column="0"
                        Height="60"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        Background="#3C3C3C"
                        Foreground="White"
                        BorderBrush="#007ACC"
                        Padding="5"
                        VerticalAlignment="Center"/>
                <Button x:Name="SendButton" 
                       Grid.Column="1"
                       Content="Send" 
                       Width="60"
                       Height="60"
                       Margin="10,0,0,0"
                       Background="#007ACC"
                       Foreground="White"
                       BorderBrush="#007ACC"
                       VerticalAlignment="Center"
                       Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
