{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rebim.local/contracts/0.1.0/command.schema.json",
  "title": "ReBIM Command Envelope",
  "description": "Provider-neutral semantic command envelope. Transport authentication is outside this envelope and is owned by RCP-02.",
  "type": "object",
  "required": ["protocolVersion", "requestId", "host", "command", "arguments"],
  "properties": {
    "protocolVersion": { "const": "0.1.0" },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "host": { "type": "string", "enum": ["revit"] },
    "command": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "contextRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "arguments": { "type": "object" }
  },
  "additionalProperties": false
}
